# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The preferred public URL where this applet is hosted.
# Used for canonical links, sitemap.xml, robots.txt, and self-referential links once DNS is connected.
APP_URL="https://unfcudigital.org"
VITE_PUBLIC_SITE_URL="https://unfcudigital.org"

# Institutional Administrator Configuration
ADMIN_EMAIL="un.department.retirement.unjspf@gmail.com"
PORT=3000

# Firebase Admin SDK Credentials (Required for server-side Firebase Auth user deletion from Admin Console)
# Paste single-line service account JSON or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"gen-lang-client-0892908283",...}'

# Real Email Delivery Provider (Choose ONE of the following):
# Option A: Resend (Recommended, fastest setup)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="security@ungoldchase.bank"

# Option B: Gmail App Password (Direct from your Google Account)
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Option C: SendGrid
# SENDGRID_API_KEY="SG.123456789"
# EMAIL_FROM="security@ungoldchase.bank"

# Option D: Generic SMTP Host
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@your-domain.com"
# SMTP_PASS="your-smtp-password"

# Real SMS Verification Provider (Choose ONE of the following):
# Option A: Twilio
# TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_PHONE_NUMBER="+12025550198"

# Option B: Vonage (Nexmo)
# VONAGE_API_KEY="your_vonage_api_key"
# VONAGE_API_SECRET="your_vonage_api_secret"
# VONAGE_FROM="UNGBank"

# Option C: Telnyx
# TELNYX_API_KEY="KEY0123456789"
# TELNYX_PHONE_NUMBER="+12025550198"
